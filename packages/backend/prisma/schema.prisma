generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
  FOUNDER
}

// @@map("unknown") — table does not exist in Supabase
model User {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  email       String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  calls       Call[]
}

model Workspace {
  id        String             @id @default(cuid())
  name      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  users     User[]
  documents KnowledgeDocument[]
  calls     Call[]

  @@map("workspaces")
}

// @@map("unknown") — table does not exist in Supabase
model KnowledgeDocument {
  id        String          @id @default(cuid())
  workspaceId String
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name      String
  path      String
  mimeType  String?
  createdAt DateTime        @default(now())
  chunks    KnowledgeChunk[]
}

// @@map("unknown") — table does not exist in Supabase
model KnowledgeChunk {
  id         String           @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  embedding  Unsupported("vector(1536)")?
  startIndex Int?
  endIndex   Int?
  createdAt  DateTime        @default(now())

  @@index([documentId])
}

// @@map("unknown") — table does not exist in Supabase
model Call {
  id             String    @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  twilioCallSid  String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  segments       TranscriptSegment[]
  suggestions    Suggestion[]
  summary        Summary?
}

// @@map("unknown") — table does not exist in Supabase
model TranscriptSegment {
  id        String   @id @default(cuid())
  callId    String
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  speaker   String
  text      String
  isFinal   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([callId])
}

// @@map("unknown") — table does not exist in Supabase
model Suggestion {
  id                 String   @id @default(cuid())
  callId             String
  call               Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  transcriptSegmentId String?
  intent             String
  confidence         Float?
  response1          String
  response2          String
  response3          String
  followUp           String
  knowledgeSnippet   String?
  createdAt          DateTime @default(now())

  @@index([callId])
}

// @@map("unknown") — table does not exist in Supabase
model Summary {
  id            String   @id @default(cuid())
  callId        String   @unique
  call          Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  overview      String
  keyTopics     Json?
  objections    Json?
  actionItems   Json?
  followUpDraft String?
  sentiment     String?
  createdAt     DateTime @default(now())
}

// Phase 2.2 — Response Generation Engine
// @@map("unknown") — table does not exist in Supabase
model Rebuttal {
  id            String   @id @default(cuid())
  raw_input     String
  category      String
  intent        String?
  emotional_tone String?
  urgency       String?
  rebuttal_1    String
  rebuttal_2    String
  rebuttal_3    String
  rebuttals_json Json?   // Full structured output including tone, framework, confidence
  confidence    Float?
  created_at    DateTime @default(now())

  @@index([category])
  @@index([created_at])
}

/// Maps to Supabase `public.profiles` (auth user profile).
model Profile {
  id             String   @id @db.Uuid
  email          String?
  planType       String   @default("free") @map("plan_type")
  usageCount     Int      @default(0) @map("usage_count")
  usageResetAt   DateTime @default(now()) @map("usage_reset_at")
  createdAt      DateTime @default(now()) @map("created_at")
  webhookSecret  String   @default("") @map("webhook_secret")
  role           UserRole @default(USER)

  @@map("profiles")
}

/// Polar (and other providers) webhook delivery idempotency — one row per processed event id.
model ProcessedWebhookEvent {
  id          String   @id
  source      String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_webhook_events")
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String   @default("")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("feature_flags")
}

model Lead {
  id                String    @id @default(uuid())
  full_name         String?
  company           String?
  work_email        String?
  phone_number      String?
  team_type         String?
  team_size         String?
  message           String?
  sms_consent       Boolean?
  source            String?
  status            String?
  notified_at       DateTime?
  utm_source        String?
  utm_medium        String?
  utm_campaign      String?
  created_at        DateTime  @default(now())
  lead_type         String?
  monthly_revenue   String?
  time_in_business  String?
  funding_amount    String?
  industry          String?
  business_type     String?

  @@map("leads")
}
